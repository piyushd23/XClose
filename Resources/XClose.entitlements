<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: the App Sandbox does not allow Accessibility control of
	     other apps or a filtering CGEvent tap. Hardened runtime needs no
	     exceptions for Accessibility, event taps or NSRunningApplication.terminate(). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
